// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Master & Template Engine (Superadmin Level)

model BusinessTemplate {
  id                   String                   @id @default(uuid())
  name                 String
  description          String?
  createdAt            DateTime                 @default(now())
  templateRoles        TemplateRole[]
  templateProfessions  TemplateProfession[]
  templateColors       TemplateBusinessColor[]
  tenants              Tenant[]

  @@map("business_templates")
}

model Superadmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  createdAt    DateTime @default(now())

  @@map("superadmins")
}

model SubscriptionPlan {
  id               String   @id @default(uuid())
  name             String   // Basic, Professional, Enterprise
  pricePerMonth    Decimal  @db.Decimal(12, 2)
  features         Json     // Array of feature strings
  maxBranches      Int      // 1, 3, etc
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  tenantSubscriptions TenantSubscription[]
  billingInvoices     BillingInvoice[]

  @@map("subscription_plans")
}

model TenantSubscription {
  id                 String           @id @default(uuid())
  tenantId           String           @unique
  subscriptionPlanId String
  status             String           // ACTIVE, PAST_DUE, CANCELED, TRIAL
  startDate          DateTime         @default(now())
  nextBillingDate    DateTime
  createdAt          DateTime         @default(now())

  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  subscriptionPlan   SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])
  
  billingInvoices    BillingInvoice[]

  @@map("tenant_subscriptions")
}

model BillingInvoice {
  id                   String             @id @default(uuid())
  tenantSubscriptionId String
  subscriptionPlanId   String
  invoiceNumber        String             @unique
  amount               Decimal            @db.Decimal(12, 2)
  status               String             // PAID, UNPAID, VOID
  invoiceDate          DateTime           @default(now())
  paidAt               DateTime?
  pdfUrl               String?

  tenantSubscription   TenantSubscription @relation(fields: [tenantSubscriptionId], references: [id])
  subscriptionPlan     SubscriptionPlan   @relation(fields: [subscriptionPlanId], references: [id])

  @@map("billing_invoices")
}

model TemplateBusinessColor {
  id                 String           @id @default(uuid())
  businessTemplateId String
  colorHex           String           
  businessTemplate   BusinessTemplate @relation(fields: [businessTemplateId], references: [id])

  @@map("template_business_colors")
}

model TemplateRole {
  id                 String           @id @default(uuid())
  businessTemplateId String
  roleCode           String           // OWNER, MANAGER, RECEPTIONIST, CASHIER, SERVICE_PROVIDER, ADMIN
  roleName           String
  businessTemplate   BusinessTemplate @relation(fields: [businessTemplateId], references: [id])
  roles              Role[]

  @@map("template_roles")
}

model TemplateProfession {
  id                 String           @id @default(uuid())
  businessTemplateId String
  professionCode     String
  professionName     String
  businessTemplate   BusinessTemplate @relation(fields: [businessTemplateId], references: [id])
  staff              Staff[]

  @@map("template_professions")
}

// 2. Tenant & Branch Configuration

model Tenant {
  id                 String           @id @default(uuid())
  slug               String           @unique
  businessTemplateId String
  name               String
  logo_photo         String?
  colorHex           String?
  createdAt          DateTime         @default(now())
  businessTemplate   BusinessTemplate @relation(fields: [businessTemplateId], references: [id])
  tenantSubscription TenantSubscription?
  
  branches           Branch[]
  roles              Role[]
  users              User[]
  staff              Staff[]
  services           Service[]
  customers          Customer[]
  medicalRecords     MedicalRecord[]
  riskForms          RiskForm[]
  appointments       Appointment[]
  orders             Order[]
  commissionLogs     CommissionLog[]
  holidays           Holiday[]
  taxSettings        TaxSetting[]
  paymentMethods     PaymentMethod[]

  @@map("tenants")
}

model Branch {
  id                 String           @id @default(uuid())
  tenantId           String
  parentId           String?
  name               String
  address            String?
  phone              String?
  receiptHeader      String?
  receiptFooter      String?
  createdAt          DateTime         @default(now())
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  parent             Branch?          @relation("BranchHierarchy", fields: [parentId], references: [id])
  
  subBranches        Branch[]         @relation("BranchHierarchy")
  branchHours        BranchHour[]
  holidays           Holiday[]
  taxSettings        TaxSetting[]
  paymentMethods     PaymentMethod[]
  rooms              Room[]
  users              User[]
  staffRosters       StaffRoster[]
  appointments       Appointment[]
  orders             Order[]

  @@map("branches")
}

model BranchHour {
  id                 String           @id @default(uuid())
  branchId           String
  dayOfWeek          Int              // 0 (Sunday) - 6 (Saturday)
  openTime           String           // HH:mm format
  closeTime          String           // HH:mm format
  isClosed           Boolean          @default(false)
  branch             Branch           @relation(fields: [branchId], references: [id])

  @@map("branch_hours")
}

model Holiday {
  id                 String           @id @default(uuid())
  tenantId           String
  branchId           String?
  name               String
  date               DateTime
  createdAt          DateTime         @default(now())
  
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  branch             Branch?          @relation(fields: [branchId], references: [id])

  @@map("holidays")
}

model TaxSetting {
  id                      String           @id @default(uuid())
  tenantId                String
  branchId                String?
  
  applyTax                Boolean          @default(true)
  taxName                 String           @default("VAT (PPN)")
  taxPercentage           Decimal          @db.Decimal(5, 2)
  
  applyServiceCharge      Boolean          @default(true)
  serviceChargePercentage Decimal          @db.Decimal(5, 2)

  tenant                  Tenant           @relation(fields: [tenantId], references: [id])
  branch                  Branch?          @relation(fields: [branchId], references: [id])

  @@map("tax_settings")
}

model PaymentMethod {
  id                 String           @id @default(uuid())
  tenantId           String
  branchId           String?
  methodCode         String           // CASH, QRIS, EDC_BCA, EDC_MANDIRI, TRANSFER, etc.
  methodName         String           
  isActive           Boolean          @default(true)
  isDefault          Boolean          @default(false)
  isCustom           Boolean          @default(false)
  details            Json?            // Stores bank details, etc.

  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  branch             Branch?          @relation(fields: [branchId], references: [id])

  @@map("payment_methods")
}

model Room {
  id                 String           @id @default(uuid())
  branchId           String
  name               String
  isActive           Boolean          @default(true)
  branch             Branch           @relation(fields: [branchId], references: [id])
  
  appointmentServices AppointmentService[]

  @@map("rooms")
}

// 3. Identity, Users & Staff Management

model Role {
  id                 String           @id @default(uuid())
  tenantId           String
  templateRoleId     String
  permissions        Json             // JSONB
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  templateRole       TemplateRole     @relation(fields: [templateRoleId], references: [id])
  users              User[]

  @@map("roles")
}

model User {
  id                 String           @id @default(uuid())
  tenantId           String
  branchId           String?
  roleId             String
  email              String           @unique
  passwordHash       String
  pinCode            String?          // VARCHAR(6)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  branch             Branch?          @relation(fields: [branchId], references: [id])
  role               Role             @relation(fields: [roleId], references: [id])
  
  staffProfile       Staff?
  cashierOrders      Order[]

  @@map("users")
}

model Staff {
  id                 String           @id @default(uuid())
  tenantId           String
  userId             String?          @unique
  professionId       String?
  fullName           String
  phone              String?
  isActive           Boolean          @default(true)
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  user               User?            @relation(fields: [userId], references: [id])
  profession         TemplateProfession? @relation(fields: [professionId], references: [id])
  
  staffRosters       StaffRoster[]
  staffServices      StaffService[]
  medicalRecords     MedicalRecord[]
  appointmentServices AppointmentService[]
  commissionLogs     CommissionLog[]

  @@map("staff")
}

model StaffRoster {
  id                 String           @id @default(uuid())
  branchId           String
  staffId            String
  workDate           DateTime         @db.Date
  startTime          String           // HH:mm
  endTime            String           // HH:mm
  isOff              Boolean          @default(false)
  branch             Branch           @relation(fields: [branchId], references: [id])
  staff              Staff            @relation(fields: [staffId], references: [id])

  @@map("staff_rosters")
}

// 4. Service Management

model Service {
  id                 String           @id @default(uuid())
  tenantId           String
  name               String
  category           String?
  price              Decimal          @db.Decimal(12, 2)
  durationMinutes    Int
  bufferTimeMinutes  Int              @default(0)
  isActive           Boolean          @default(true)
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  
  staffServices      StaffService[]
  serviceAddOns      ServiceAddOn[]
  multiStepServices  MultiStepService[]
  appointmentServices AppointmentService[]

  @@map("services")
}

model StaffService {
  staffId            String
  serviceId          String
  staff              Staff            @relation(fields: [staffId], references: [id])
  service            Service          @relation(fields: [serviceId], references: [id])

  @@id([staffId, serviceId])
  @@map("staff_services")
}

model ServiceAddOn {
  id                     String           @id @default(uuid())
  serviceId              String
  name                   String
  price                  Decimal          @db.Decimal(12, 2)
  extraDurationMinutes   Int              @default(0)
  service                Service          @relation(fields: [serviceId], references: [id])

  @@map("service_add_ons")
}

model MultiStepService {
  id                     String           @id @default(uuid())
  parentServiceId        String
  stepOrder              Int
  stepName               String
  durationMinutes        Int
  pauseDurationMinutes   Int              @default(0)
  service                Service          @relation(fields: [parentServiceId], references: [id])

  @@map("multi_step_services")
}

// 5. Customer 360 & Medical Records

model Customer {
  id                 String           @id @default(uuid())
  tenantId           String
  fullName           String
  phone              String?
  email              String?
  noShowCount        Int              @default(0)
  isFlaggedRisk      Boolean          @default(false)
  createdAt          DateTime         @default(now())
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  
  medicalRecords     MedicalRecord[]
  riskForms          RiskForm[]
  appointments       Appointment[]
  orders             Order[]

  @@map("customers")
}

model MedicalRecord {
  id                   String           @id @default(uuid())
  tenantId             String
  customerId           String
  doctorOrTherapistId  String
  diagnosisNotes       String?
  treatmentGiven       String?
  allergies            String?
  createdAt            DateTime         @default(now())
  tenant               Tenant           @relation(fields: [tenantId], references: [id])
  customer             Customer         @relation(fields: [customerId], references: [id])
  doctorOrTherapist    Staff            @relation(fields: [doctorOrTherapistId], references: [id])

  @@map("medical_records")
}

model RiskForm {
  id                     String           @id @default(uuid())
  tenantId               String
  customerId             String
  formTitle              String
  digitalSignatureUrl    String
  signedAt               DateTime
  tenant                 Tenant           @relation(fields: [tenantId], references: [id])
  customer               Customer         @relation(fields: [customerId], references: [id])

  @@map("risk_forms")
}

// 6. Appointment & Scheduling Engine

model Appointment {
  id                 String           @id @default(uuid())
  tenantId           String
  branchId           String
  customerId         String
  bookingCode        String           @unique
  appointmentDate    DateTime         @db.Date
  startTime          String           // HH:mm
  endTime            String           // HH:mm
  status             String           // SCHEDULED, CHECKED_IN, IN_SERVICE, COMPLETED, CANCELLED, NO_SHOW
  notes              String?
  createdAt          DateTime         @default(now())
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  branch             Branch           @relation(fields: [branchId], references: [id])
  customer           Customer         @relation(fields: [customerId], references: [id])
  
  appointmentServices AppointmentService[]
  orders             Order[]

  @@map("appointments")
}

model AppointmentService {
  id                 String           @id @default(uuid())
  appointmentId      String
  serviceId          String
  staffId            String
  roomId             String?
  price              Decimal          @db.Decimal(12, 2)
  startTime          String           // HH:mm
  endTime            String           // HH:mm
  appointment        Appointment      @relation(fields: [appointmentId], references: [id])
  service            Service          @relation(fields: [serviceId], references: [id])
  staff              Staff            @relation(fields: [staffId], references: [id])
  room               Room?            @relation(fields: [roomId], references: [id])

  @@map("appointment_services")
}

// 7. POS, Transactions & Commission Logs

model Order {
  id                     String           @id @default(uuid())
  tenantId               String
  branchId               String
  appointmentId          String?
  customerId             String
  invoiceNumber          String           @unique
  subtotal               Decimal          @db.Decimal(12, 2)
  taxAmount              Decimal          @default(0) @db.Decimal(12, 2)
  serviceChargeAmount    Decimal          @default(0) @db.Decimal(12, 2)
  discountAmount         Decimal          @default(0) @db.Decimal(12, 2)
  grandTotal             Decimal          @db.Decimal(12, 2)
  paymentMethod          String?          // CASH, QRIS, CARD, TRANSFER
  paymentStatus          String           // UNPAID, PAID, REFUNDED
  cashierId              String
  paidAt                 DateTime?
  tenant                 Tenant           @relation(fields: [tenantId], references: [id])
  branch                 Branch           @relation(fields: [branchId], references: [id])
  appointment            Appointment?     @relation(fields: [appointmentId], references: [id])
  customer               Customer         @relation(fields: [customerId], references: [id])
  cashier                User             @relation(fields: [cashierId], references: [id])
  
  orderItems             OrderItem[]

  @@map("orders")
}

model OrderItem {
  id                 String           @id @default(uuid())
  orderId            String
  itemType           String           // SERVICE, ADD_ON, PRODUCT
  itemId             String           // No direct prisma relation since it's polymorphic
  itemName           String
  qty                Int              @default(1)
  price              Decimal          @db.Decimal(12, 2)
  totalPrice         Decimal          @db.Decimal(12, 2)
  order              Order            @relation(fields: [orderId], references: [id])

  commissionLogs     CommissionLog[]

  @@map("order_items")
}

model CommissionLog {
  id                 String           @id @default(uuid())
  tenantId           String
  orderItemId        String
  staffId            String
  commissionType     String           // PERCENTAGE / FLAT
  commissionValue    Decimal          @db.Decimal(12, 2)
  earnedAmount       Decimal          @db.Decimal(12, 2)
  splitRatio         Decimal          @default(1.00) @db.Decimal(3, 2)
  createdAt          DateTime         @default(now())
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  orderItem          OrderItem        @relation(fields: [orderItemId], references: [id])
  staff              Staff            @relation(fields: [staffId], references: [id])

  @@map("commission_logs")
}
